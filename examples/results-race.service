# systemd user/service unit.  Copy to ~/.config/systemd/user/ (then `systemctl --user enable --now results-race`)
[Unit]
Description=results-race
After=network-online.target

[Service]
WorkingDirectory=/path/to/workdir
ExecStart=/path/to/venv/bin/results-race --config /path/to/workdir/results-race.toml
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=default.target
